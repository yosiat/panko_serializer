source "https://rubygems.org"

gem "activesupport", "~> 8.1.0"
gem "activemodel", "~> 8.1.0"
gem "activerecord", "~> 8.1.0", group: :test
gem "trilogy"
gem "sqlite3", ">= 2.1"

group :benchmarks do
  gem "stackprof"
  gem "benchmark-ips"
  gem "memory_profiler"
  gem "oj_serializers"
  gem "alba"
  gem "blueprinter"
end

group :test do
  gem "faker"
  gem "temping"
end

group :development do
  gem "rake"
  gem "rspec", "~> 3.0"
  gem "lefthook"
end

group :development, :test do
  gem "rubocop"
  gem "standard"
  gem "standard-performance"
  gem "rubocop-performance"
  gem "rubocop-rspec"
end

gemspec path: "../"
